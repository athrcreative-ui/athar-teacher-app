{
  "name": "athar-teacher-app-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "validate:content": "tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:run": "vitest run --pool=forks",
    "security:scan": "node scripts/scan-secrets.mjs",
    "check": "npm run validate:content && npm run typecheck && npm run test:run && npm run security:scan",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "konva": "10.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "19.2.7",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
